name: Sync Fork with Upstream (Rebase)

on:
  # Run daily at 3 AM UTC
  schedule:
    - cron: '0 3 * * *'

  # Allow manual trigger
  workflow_dispatch:

  # Run when upstream has new releases
  repository_dispatch:
    types: [upstream-update]

jobs:
  sync:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout fork
        uses: actions/checkout@v4
        with:
          ref: develop
          fetch-depth: 0  # Full history needed for rebase
          token: ${{ secrets.GITHUB_TOKEN }}

      - name: Configure git
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"

      - name: Add upstream remote
        run: |
          git remote add upstream https://github.com/supabase/cli.git || true
          git fetch upstream --tags

      - name: Check for upstream changes
        id: check
        run: |
          UPSTREAM_SHA=$(git rev-parse upstream/develop)
          CURRENT_SHA=$(git rev-parse HEAD)
          echo "upstream_sha=$UPSTREAM_SHA" >> $GITHUB_OUTPUT
          echo "current_sha=$CURRENT_SHA" >> $GITHUB_OUTPUT

          if [ "$UPSTREAM_SHA" = "$CURRENT_SHA" ]; then
            echo "has_changes=false" >> $GITHUB_OUTPUT
            echo "✓ Fork is up to date with upstream"
          else
            echo "has_changes=true" >> $GITHUB_OUTPUT
            echo "⚠ Upstream has new changes"
          fi

      - name: Rebase on upstream/develop
        if: steps.check.outputs.has_changes == 'true'
        run: |
          echo "Starting rebase..."

          # Attempt rebase
          if git rebase upstream/develop; then
            echo "✓ Rebase successful"
            echo "rebase_status=success" >> $GITHUB_ENV
          else
            echo "⚠ Rebase had conflicts - attempting smart resolution"
            echo "rebase_status=conflict" >> $GITHUB_ENV

            # Check if conflicts are only in go.mod/go.sum (expected)
            CONFLICT_FILES=$(git diff --name-only --diff-filter=U)
            echo "Conflicted files: $CONFLICT_FILES"

            if echo "$CONFLICT_FILES" | grep -q "go.mod\|go.sum"; then
              echo "→ Conflicts in go.mod/go.sum (expected due to our ethereum replacement)"

              # Keep our version of the ethereum replacement in go.mod
              git checkout --ours go.mod
              git checkout --ours go.sum
              git add go.mod go.sum

              # Continue rebase
              if git rebase --continue; then
                echo "✓ Rebase completed after resolving go.mod conflicts"
                echo "rebase_status=success" >> $GITHUB_ENV
              else
                echo "✗ Rebase failed even after conflict resolution"
                git rebase --abort
                echo "rebase_status=failed" >> $GITHUB_ENV
              fi
            else
              echo "✗ Unexpected conflicts in: $CONFLICT_FILES"
              git rebase --abort
              echo "rebase_status=failed" >> $GITHUB_ENV
            fi
          fi

      - name: Verify go-ethereum replacement is intact
        if: steps.check.outputs.has_changes == 'true' && env.rebase_status == 'success'
        run: |
          echo "Verifying our ethereum stub is still in place..."

          if [ -d "internal/go-ethereum-stub" ]; then
            echo "✓ Ethereum stub directory exists"
          else
            echo "✗ Ethereum stub directory missing!"
            exit 1
          fi

          if grep -q "replace github.com/ethereum/go-ethereum" go.mod; then
            echo "✓ Replace directive present in go.mod"
          else
            echo "✗ Replace directive missing from go.mod!"
            exit 1
          fi

          echo "✓ All checks passed - ethereum replacement intact"

      - name: Run tests
        if: steps.check.outputs.has_changes == 'true' && env.rebase_status == 'success'
        run: |
          # Quick smoke test to ensure build still works
          export GOSUMDB=off
          export CGO_ENABLED=0

          go mod tidy
          go build -v ./...

          echo "✓ Build successful after rebase"

      - name: Push rebased changes
        if: steps.check.outputs.has_changes == 'true' && env.rebase_status == 'success'
        run: |
          git push --force-with-lease origin develop
          echo "✓ Successfully pushed rebased develop branch"

      - name: Create issue on failure
        if: failure() && env.rebase_status == 'failed'
        uses: actions/github-script@v7
        with:
          script: |
            const issue = await github.rest.issues.create({
              owner: context.repo.owner,
              repo: context.repo.repo,
              title: '⚠️ Upstream sync failed - Manual intervention needed',
              body: `## Automated Sync Failed

              The automated rebase from upstream failed with conflicts that couldn't be auto-resolved.

              **Upstream SHA:** \`${{ steps.check.outputs.upstream_sha }}\`
              **Current SHA:** \`${{ steps.check.outputs.current_sha }}\`

              ### Manual Resolution Required

              \`\`\`bash
              git fetch upstream
              git rebase upstream/develop
              # Resolve conflicts manually
              git push --force-with-lease origin develop
              \`\`\`

              **Action Run:** ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
              `,
              labels: ['upstream-sync', 'needs-attention']
            });

            console.log('Created issue #' + issue.data.number);

      - name: Summary
        if: always()
        run: |
          echo "## Sync Summary" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "- **Upstream SHA:** \`${{ steps.check.outputs.upstream_sha }}\`" >> $GITHUB_STEP_SUMMARY
          echo "- **Fork SHA:** \`${{ steps.check.outputs.current_sha }}\`" >> $GITHUB_STEP_SUMMARY
          echo "- **Has Changes:** ${{ steps.check.outputs.has_changes }}" >> $GITHUB_STEP_SUMMARY
          echo "- **Rebase Status:** ${rebase_status:-skipped}" >> $GITHUB_STEP_SUMMARY

          if [ "${rebase_status}" = "success" ]; then
            echo "" >> $GITHUB_STEP_SUMMARY
            echo "✅ **Fork successfully synced with upstream!**" >> $GITHUB_STEP_SUMMARY
          elif [ "${rebase_status}" = "failed" ]; then
            echo "" >> $GITHUB_STEP_SUMMARY
            echo "❌ **Sync failed - manual intervention required**" >> $GITHUB_STEP_SUMMARY
          else
            echo "" >> $GITHUB_STEP_SUMMARY
            echo "ℹ️ **No changes needed - fork is up to date**" >> $GITHUB_STEP_SUMMARY
          fi
